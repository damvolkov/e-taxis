# Copy to .env — runtime config, every value optional (defaults live in the code).
# core/, ops/ and adapters/ are materialized from ../core: edit them there, never here.
#
# APP_ENV=dev                    # dev | local | prod (logger rendering, always on stderr)
# CLI_HISTORY=50                 # runs the undo journal keeps
# DB_PATH=data/app.db            # the local store: the undo journal
# TAXIS_CATALOG=                 # catalog root (entries/, profiles/); default: the one packaged in e_taxis/catalog
# TAXIS_TIMEOUT=10               # seconds each probe or verify may run before it counts as absent
